COMPOSE_PROJECT_NAME=foodlens
FOODLENS_API_PORT=18431
APP_ENV=production
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

POSTGRES_DB=foodlens
POSTGRES_USER=foodlens
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://foodlens:change-this-password@postgres:5432/foodlens
TOKEN_PEPPER=replace-with-a-long-random-secret
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-recipient
BACKUP_AGE_IDENTITY=/secure/path/to/foodlens-age-identity.txt
MINIO_ROOT_USER=foodlens
MINIO_ROOT_PASSWORD=change-this-password-too

VISION_PROVIDER=mock
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
